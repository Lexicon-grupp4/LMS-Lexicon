@page "/"
@using LMS.Blazor.Client.Components
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.DTOs.DashboardDtos
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Student")]

@inject IApiProxyClient ApiProxyClient

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-page">

    <PageHeader Title="Dashboard"
                Description="Här ser du veckans aktiviteter, kommande inlämningar och senaste information." />

    @if (dashboard is null)
    {
        <p>Laddar dashboard...</p>
    }
    else
    {
        <section class="dashboard-section">
            <h2>Veckans aktiviteter</h2>

            @if (dashboard.UpcomingActivities.Count == 0)
            {
                <p>Inga kommande aktiviteter.</p>
            }
            else
            {
                @foreach (var activity in dashboard.UpcomingActivities)
                {
                    <div class="activity-card">
                        <div>
                            <span class="activity-type">
                                @activity.ActionTypeName
                            </span>

                            <h3>@activity.Title</h3>

                            <p>
                                @activity.StartDate.ToLocalTime().ToString("yyyy-MM-dd")
                                ·
                                @activity.StartDate.ToLocalTime().ToString("HH:mm")–@activity.EndDate.ToLocalTime().ToString("HH:mm")
                            </p>
                        </div>
                    </div>
                }
            }
        </section>

        <div class="dashboard-grid">

            <section class="dashboard-section">
                <h2>Kommande inlämningar</h2>

                @if (dashboard.AssignmentsNeedingAttention.Count == 0)
                {
                    <p>Inga kommande inlämningar.</p>
                }
                else
                {
                    @foreach (var assignment in dashboard.AssignmentsNeedingAttention)
                    {
                        <div class="assignment-item">
                            <div>
                                <strong>@assignment.Title</strong>

                                <p>
                                    Deadline:
                                    @assignment.Deadline.ToLocalTime().ToString("yyyy-MM-dd")
                                </p>
                            </div>

                            <span>@assignment.Status</span>
                        </div>
                    }
                }
            </section>

            <section class="dashboard-section">
                <h2>Senaste dokument</h2>

                @if (dashboard.RecentDocuments.Count == 0)
                {
                    <p>Inga senaste dokument.</p>
                }
                else
                {
                    @foreach (var document in dashboard.RecentDocuments)
                    {
                        <div class="activity-card">
                            <div>
                                <strong>@document.FileName</strong>

                                <p>
                                    @document.UploadAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                </p>
                            </div>
                        </div>
                    }
                }
            </section>

        </div>

        <div class="dashboard-grid">

            <section class="dashboard-section">
                <h2>Senaste feedback</h2>

                @if (dashboard.RecentFeedback.Count == 0)
                {
                    <p>Ingen senaste feedback.</p>
                }
                else
                {
                    @foreach (var feedback in dashboard.RecentFeedback)
                    {
                        <div class="activity-card">
                            <div>
                                <strong>Feedback</strong>

                                <p>@feedback.Comment</p>

                                <p>
                                    Betyg: @feedback.Grade
                                </p>

                                <small>
                                    @feedback.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                </small>
                            </div>
                        </div>
                    }
                }
            </section>

            <section class="dashboard-section">
                <h2>Senaste notifieringar</h2>

                @if (dashboard.RecentNotifications.Count == 0)
                {
                    <p>Inga senaste notifieringar.</p>
                }
                else
                {
                    @foreach (var notification in dashboard.RecentNotifications)
                    {
                        <div class="activity-card">
                            <div>
                                <strong>
                                    @(notification.IsRead ? "Läst" : "Ny")
                                </strong>

                                <p>@notification.Message</p>

                                <small>
                                    @notification.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                </small>
                            </div>
                        </div>
                    }
                }
            </section>

        </div>
    }

</div>

@code {
    private DashboardDto? dashboard;

    protected override async Task OnInitializedAsync()
    {
        dashboard = await ApiProxyClient.GetAsync<DashboardDto>(
            "dashboard/student");
    }
}
@page "/"
@using LMS.Blazor.Client.Components

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-page">

    <PageHeader Title="Dashboard"
                Description="Här ser du veckans aktiviteter och kommande inlämningar." />

    <section class="dashboard-section">
        <h2>Veckans aktiviteter</h2>

        <div class="activity-card">
            <div>
                <span class="activity-type">Föreläsning</span>
                <h3>Introduction till React</h3>
                <p>2026-10-06 · 09:00–12:00</p>
            </div>
            <span class="document-link">Dokument</span>
        </div>

        <div class="activity-card">
            <div>
                <span class="activity-type">Övning</span>
                <h3>React komponenter</h3>
                <p>2026-10-07 · 09:00–12:00</p>
            </div>
            <span class="document-link">Dokument</span>
        </div>

        <div class="activity-card">
            <div>
                <span class="activity-type">E-learning</span>
                <h3>React Hooks</h3>
                <p>2026-10-08 · 09:00–12:00</p>
            </div>
        </div>
    </section>

    <div class="dashboard-grid">

        <section class="dashboard-section">
            <h2>Kommande inlämningar</h2>

            <div class="assignment-item">
                <div>
                    <strong>React application</strong>
                    <p>Deadline: 2026-10-10</p>
                </div>
                <span>Ej inlämnad</span>
            </div>

            <div class="assignment-item">
                <div>
                    <strong>Databasdesign</strong>
                    <p>Deadline: 2026-10-15</p>
                </div>
                <span>Ej inlämnad</span>
            </div>
        </section>

        <section class="dashboard-section">
            <h2>Modulframsteg</h2>

            <div class="progress-item">
                <span>HTML & CSS</span>
                <div class="progress">
                    <div class="progress-bar" style="width: 100%"></div>
                </div>
                <small>100%</small>
            </div>

            <div class="progress-item">
                <span>Javascript</span>
                <div class="progress">
                    <div class="progress-bar" style="width: 60%"></div>
                </div>
                <small>60%</small>
            </div>

            <div class="progress-item">
                <span>React</span>
                <div class="progress">
                    <div class="progress-bar" style="width: 20%"></div>
                </div>
                <small>20%</small>
            </div>

        </section>

    </div>

</div>
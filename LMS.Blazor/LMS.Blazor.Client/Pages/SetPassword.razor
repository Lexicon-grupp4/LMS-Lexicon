@page "/users/set-password"

@using LMS.Shared.DTOs.UserDtos
@using LMS.Blazor.Client.Services.ApiProxy

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager

<PageTitle>Set Password</PageTitle>

<h3>Set Your Password</h3>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@if (success)
{
    <div class="alert alert-success" role="alert">
        Your password has been set successfully.
    </div>

    <a href="@NavigationManager.ToAbsoluteUri("/Account/Login")"
       class="btn btn-primary">
        Go to Login
    </a>
}
else
{
    <EditForm Model="model" OnValidSubmit="SubmitPassword">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label for="password" class="form-label">
                New Password
            </label>

            <InputText id="password"
                       class="form-control"
                       type="password"
                       autocomplete="new-password"
                       @bind-Value="model.Password" />

            <ValidationMessage For="@(() => model.Password)" />
        </div>

        <div class="mb-3">
            <label for="confirmPassword" class="form-label">
                Confirm Password
            </label>

            <InputText id="confirmPassword"
                       class="form-control"
                       type="password"
                       autocomplete="new-password"
                       @bind-Value="model.ConfirmPassword" />

            <ValidationMessage For="@(() => model.ConfirmPassword)" />
        </div>

        <button type="submit"
                class="btn btn-primary"
                disabled="@isSaving">
            @(isSaving ? "Saving..." : "Set Password")
        </button>
    </EditForm>
}

@code {
    [SupplyParameterFromQuery(Name = "userId")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    private readonly SetPasswordDto model = new();

    private bool isSaving;
    private bool success;
    private string? errorMessage;

    private async Task SubmitPassword()
    {
        if (string.IsNullOrWhiteSpace(UserId) ||
            string.IsNullOrWhiteSpace(Token))
        {
            errorMessage =
                "The password setup link is invalid or expired.";
            return;
        }

        isSaving = true;
        errorMessage = null;

        try
        {
            model.UserId = UserId;
            model.Token = Token;

            await ApiProxyClient.PostAsync<SetPasswordDto, object>(
                "users/set-password",
                model);

            success = true;
        }
        catch (Exception)
        {
            errorMessage =
                "Unable to set your password. " +
                "The link may be invalid or expired.";
        }
        finally
        {
            isSaving = false;
        }
    }
}

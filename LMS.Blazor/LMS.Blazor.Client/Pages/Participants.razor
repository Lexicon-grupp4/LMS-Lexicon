@page "/participants"
@using LMS.Blazor.Client.Components

<PageTitle>Participants</PageTitle>

<div class="participants-page">

    <PageHeader Title="Participants"
                Description="Here you can see the participants in your course." />

    <section class="participant-group">

        <div class="participant-group-heading">
            <h2>Teachers</h2>
            <span>1</span>
        </div>

        <ul class="participants-card">

            <li class="participant-row">

                <div class="participant-avatar teacher">
                    AK
                </div>

                <div class="participant-content">

                    <div class="participant-name-row">
                        <h3>Anna Karlsson</h3>
                    </div>

                    <a href="mailto:anna.karlsson@example.com"
                       class="participant-email">
                        <span class="mail-icon">✉</span>
                        anna.karlsson@example.com
                    </a>

                </div>

            </li>

        </ul>

    </section>

    <section class="participant-group">

        <div class="participant-group-heading">
            <h2>Students</h2>
            <span>3</span>
        </div>

        <ul class="participants-card">

            <li class="participant-row">

                <div class="participant-avatar student">
                    MJ
                </div>

                <div class="participant-content">

                    <div class="participant-name-row">
                        <h3>Mohamed Jama</h3>

                        <span class="current-user-badge">
                            You
                        </span>
                    </div>

                    <a href="mailto:mohamed.jama@example.com"
                       class="participant-email">
                        <span class="mail-icon">✉</span>
                        mohamed.jama@example.com
                    </a>

                </div>

            </li>

            <li class="participant-row">

                <div class="participant-avatar student">
                    SL
                </div>

                <div class="participant-content">

                    <div class="participant-name-row">
                        <h3>Sara Lind</h3>
                    </div>

                    <a href="mailto:sara.lind@example.com"
                       class="participant-email">
                        <span class="mail-icon">✉</span>
                        sara.lind@example.com
                    </a>

                </div>

            </li>

            <li class="participant-row">

                <div class="participant-avatar student">
                    JD
                </div>

                <div class="participant-content">

                    <div class="participant-name-row">
                        <h3>Johan Dahl</h3>
                    </div>

                    <a href="mailto:johan.dahl@example.com"
                       class="participant-email">
                        <span class="mail-icon">✉</span>
                        johan.dahl@example.com
                    </a>

                </div>

            </li>

        </ul>

    </section>

</div>
@page "/participants"
@using LMS.Blazor.Client.Components
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.DTOs.UserDtos
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Student")]

@inject IApiProxyClient ApiProxyClient

<PageTitle>Participants</PageTitle>

<div class="participants-page">

    <PageHeader Title="Participants"
                Description="Here you can see the participants in your course." />

    @if (isLoading)
    {
        <ContentState Type="loading" />
    }
    else if (hasError)
    {
        <ContentState Type="error"
                      Message="Could not load the participants." />
    }
    else if (participants.Count == 0)
    {
        <ContentState Type="empty"
                      Message="There are no participants to display." />
    }
    else
    {
        <div class="participants-card">

            @foreach (var participant in participants)
            {
                <div class="participant-row">
                    <div class="participant-avatar">@GetInitials(participant)</div>
                    <div class="participant-info">
                        <h2>@participant.FirstName @participant.LastName</h2>
                        <p>@participant.Email</p>
                    </div>
                </div>
            }

        </div>
    }

</div>

@code {
    private List<CourseParticipantDto> participants = [];
    private bool isLoading = true;
    private bool hasError = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await ApiProxyClient.GetAsync<List<CourseParticipantDto>>(
                "courses/my-course/participants");

            participants = result ?? [];
        }
        catch (Exception)
        {
            // Also covers 404 when the student has no course.
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetInitials(CourseParticipantDto participant) =>
        $"{participant.FirstName.FirstOrDefault()}{participant.LastName.FirstOrDefault()}"
            .ToUpper();
}

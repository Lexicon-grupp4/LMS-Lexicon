@page "/users/create"

@using LMS.Shared.DTOs.UserDtos
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Blazor.Client.Services.ApiProxy
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Teacher")]

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager

<PageTitle>Add User</PageTitle>

<h3>Add User</h3>

@if (isLoadingCourses)
{
    <div class="text-center mb-3">
        <span class="spinner-border spinner-border-sm"></span>
        Loading courses...
    </div>
}

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<EditForm Model="model" OnValidSubmit="CreateUser">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">First Name</label>
        <InputText class="form-control"
                   @bind-Value="model.FirstName" />
    </div>

    <div class="mb-3">
        <label class="form-label">Last Name</label>
        <InputText class="form-control"
                   @bind-Value="model.LastName" />
    </div>

    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control"
                   type="email"
                   @bind-Value="model.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label">Role</label>
        <InputSelect class="form-select"
                     @bind-Value="model.Role">
            <option value="">-- Select role --</option>
            <option value="Student">Student</option>
            <option value="Teacher">Teacher</option>
        </InputSelect>
    </div>

    <div class="mb-3">
        <label class="form-label">Course (Optional)</label>

        <InputSelect class="form-select"
                     @bind-Value="model.CourseId"
                     disabled="@isLoadingCourses">

            <option value="">-- Select course --</option>

            @foreach (var course in courses)
            {
                <option value="@course.Id">
                    @course.Name
                </option>
            }
        </InputSelect>

        <div class="form-text">
            Select a course to assign to the user, or leave it unassigned.
        </div>
    </div>

    <div class="alert alert-info">
        The user will receive a password setup link
        after the account has been created.
    </div>

    <button type="submit"
            class="btn btn-primary"
            disabled="@isSaving">

        @if (isSaving)
        {
            <span>
                <span class="spinner-border spinner-border-sm me-1"></span>
                Creating...
            </span>
        }
        else
        {
            <span>
                <span class="bi bi-person-plus"></span>
                Create User
            </span>
        }
    </button>

    <button type="button"
            class="btn btn-secondary ms-2"
            @onclick="Cancel"
            disabled="@isSaving">
        Cancel
    </button>
</EditForm>

@code {
    private CreateUserDto model = new();

    private List<CourseDto> courses = new();

    private bool isSaving;
    private bool isLoadingCourses = true;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadCourses();
    }

    private async Task LoadCourses()
    {
        isLoadingCourses = true;

        try
        {
            var result = await ApiProxyClient
                .GetAsync<List<CourseDto>>("course");

            courses = result ?? new List<CourseDto>();
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                "/Account/Login",
                forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load courses: {ex.Message}";
        }
        finally
        {
            isLoadingCourses = false;
        }
    }

    private async Task CreateUser()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            var result = await ApiProxyClient.PostAsync<
                CreateUserDto,
                CreateUserResponseDto>(
                "users",
                model);

            if (result is null)
            {
                errorMessage = "The user could not be created.";
                return;
            }

            var setupUrl =
                $"/users/set-password" +
                $"?userId={Uri.EscapeDataString(result.User.Id)}" +
                $"&token={Uri.EscapeDataString(result.PasswordSetupToken)}";

            NavigationManager.NavigateTo(setupUrl);
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                "/Account/Login",
                forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/users");
    }
}
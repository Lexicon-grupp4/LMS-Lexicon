@page "/course/create"
@using LMS.Blazor.Client.Components
@using LMS.Blazor.Client.Models
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.DTOs.CourseDtos

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager

<PageTitle>Create Course</PageTitle>

<div class="course-page">
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
    <CourseForm Model="model" OnValidSubmit="HandleValidSubmit" IsSubmitting="isSubmitting" SubmitButtonText="Create" />
</div>

@code {
    private CourseFormModel model = new();
    private bool isSubmitting = false;
    private string errorMessage = string.Empty;

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        errorMessage = string.Empty;
        try
        {
            var dto = new NewCourseDto(
                model.Name,
                model.Code,
                model.Description,
                model.StartDate,
                model.EndDate);

            await ApiProxyClient.PostAsync<NewCourseDto, CourseDto>("courses", dto);
            NavigationManager.NavigateTo("/courses");
        }
        catch (Exception ex)
        {
            errorMessage = "Could not create the course: " + ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }
}

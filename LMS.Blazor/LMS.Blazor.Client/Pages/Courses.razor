
@page "/courses"

@using LMS.Blazor.Client.Components
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.DTOs.CourseDtos

@inject IApiProxyClient ApiProxyClient
@inject IJSRuntime JS

<PageTitle>Course Management</PageTitle>

<div class="courses-page">
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }
    @if (courses is null)
    {
        <p>Loading...</p>
    }
    else
    {
        <p><NavLink href="/course/create" class="btn btn-sm btn-secondary ms-2">New course</NavLink></p>
        <div class="table - responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Course</th>
                        <th>Code</th>
                        <th>Description</th>
                        <th>Start date</th>
                        <th>End date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in courses)
                    {
                        <tr>
                            <td>
                                <NavLink class="btn btn-sm btn-primary ms-2" href="@($"/t-course/{c.Id}")">
                                    @c.Name
                                </NavLink>
                            </td>
                            <td>@c.Code</td>
                            <td>@c.Description</td>
                            <td>@c.StartDate.ToShortDateString()</td>
                            <td>@c.EndDate.ToShortDateString()</td>
                            <td>
                                <NavLink class="btn btn-sm btn-secondary ms-2" href="@($"/course/edit/{c.Id}")">
                                    Edit
                                </NavLink>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-danger ms-2"
                                        disabled="@deletingIds.Contains(c.Id)"
                                        @onclick="() => DeleteCourseAsync(c.Id)">
                                    @(deletingIds.Contains(c.Id) ? "Deleting..." : "Delete")
                                </button>
                            </td>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var c in courses)
                        {
                            <tr>

                                <!-- COURSE NAME -->
                                <td>
                                    <a class="courses-name-link"
                                       href="@($"/t-course/{c.Id}")">

                                        <span class="courses-name-icon"
                                              aria-hidden="true">
                                            ▤
                                        </span>

                                        <span>@c.Name</span>

                                    </a>
                                </td>

                                <!-- COURSE CODE -->
                                <td>
                                    <span class="courses-code">
                                        @c.Code
                                    </span>
                                </td>

                                <!-- COURSE ID -->
                                <td class="courses-id">
                                    @c.Id
                                </td>

                                <!-- DESCRIPTION -->
                                <td class="courses-description">
                                    @c.Description
                                </td>

                                <!-- START DATE -->
                                <td class="courses-date">
                                    @c.StartDate.ToShortDateString()
                                </td>

                                <!-- END DATE -->
                                <td class="courses-date">
                                    @c.EndDate.ToShortDateString()
                                </td>

                                <!-- ACTIONS -->
                                <td>
                                    <div class="courses-actions">

                                        <!-- EDIT -->
                                        <a class="courses-edit-button"
                                           href="@($"/course/edit/{c.Id}")">
                                            Edit
                                        </a>

                                        <!-- DELETE -->
                                        <button type="button"
                                                class="courses-delete-button"
                                                disabled="@deletingIds.Contains(c.Id)"
                                                @onclick="() => DeleteCourseAsync(c.Id)">

                                            @(deletingIds.Contains(c.Id)
                                                ? "Deleting..."
                                                : "Delete")

                                        </button>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </section>

</div>

@code {
    private CourseDto[]? courses;
    private readonly HashSet<int> deletingIds = new();
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCoursesAsync();
    }

    private async Task LoadCoursesAsync()
    {
        courses = await ApiProxyClient.GetAsync<CourseDto[]>("courses");
    }

    private async Task DeleteCourseAsync(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>(
            "confirm",
            $"Delete course #{id}?");

        if (!confirmed)
            return;

        deletingIds.Add(id);
        StateHasChanged();

        try
        {
            await ApiProxyClient.DeleteAsync($"courses/{id}");
            await LoadCoursesAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Failed to delete course: " + ex.Message;
        }
        finally
        {
            deletingIds.Remove(id);
            StateHasChanged();
        }
    }
}

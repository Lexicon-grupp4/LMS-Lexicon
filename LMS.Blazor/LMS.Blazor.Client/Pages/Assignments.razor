@page "/assignments"
@using LMS.Blazor.Client.Components

<PageTitle>Assignments</PageTitle>

<div class="assignments-page">

    <PageHeader Title="Assignments"
                Description="Here you can see your assignments and their status." />

    @if (isLoading)
    {
        <ContentState Type="loading" />
    }
    else if (hasError)
    {
        <ContentState Type="error"
                      Message="Could not load the assignments." />
    }
    else if (!hasAssignments)
    {
        <ContentState Type="empty"
                      Message="There are no assignments to display." />
    }
    else
    {
        <div class="assignment-card">
            <div>
                <span class="assignment-status pending">Not Submitted</span>
                <h2>React Application</h2>
                <p>Deadline: 2026-10-10</p>
            </div>

            <button class="assignment-button">
                Submit
            </button>
        </div>

        <div class="assignment-card">
            <div>
                <span class="assignment-status submitted">Submitted</span>
                <h2>Database Design</h2>
                <p>Deadline: 2026-10-15</p>
            </div>

            <button class="assignment-button secondary">
                View Submission
            </button>
        </div>

        <div class="assignment-card">
            <div>
                <span class="assignment-status late">Overdue</span>
                <h2>ASP.NET Core Exercise</h2>
                <p>Deadline: 2026-10-05</p>
            </div>

            <button class="assignment-button">
                Submit
            </button>
        </div>
    }

</div>

@code {
    private bool isLoading = false;
    private bool hasError = false;
    private bool hasAssignments = true;
}
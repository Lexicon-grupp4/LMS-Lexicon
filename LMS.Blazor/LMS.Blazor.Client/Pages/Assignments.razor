@page "/assignments"
@using LMS.Blazor.Client.Components
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.DTOs.AssignmentDtos
@using LMS.Shared.Enum;
@using LMS.Shared.Paging
@inject IApiProxyClient ApiProxyClient


<PageTitle>Assignments</PageTitle>

<div class="assignments-page">

    <PageHeader Title="Assignments"
                Description="Here you can see your assignments and their status." />

    @if (isLoading)
    {
        <ContentState Type="loading" />
    }
    else if (hasError)
    {
        <ContentState Type="error"
                      Message="Could not load the assignments." />
    }
    else if (!hasAssignments)
    {
        <ContentState Type="empty"
                      Message="There are no assignments to display." />
    }
    else
    {
        @foreach (var assignment in assignments)
        {
            <div class="assignment-card">

                <div class="assignment-content">
                    <span class="assignment-status @GetStatusClass(assignment)">
                        @GetStatusText(assignment)
                    </span>

                    <h2>@assignment.Name</h2>

                    <p class="assignment-deadline">
                        Deadline: @assignment.Deadline.ToString("dd MMM yyyy")
                    </p>
                </div>

                <button class="assignment-button secondary"
                        @onclick="() => ViewDetails(assignment)">
                    View details
                </button>

            </div>
        }
    }
    @if (showDetailsModal && selectedAssignment is not null)
    {
        <div class="assignment-modal-backdrop"
             @onclick="CloseDetails">

            <div class="assignment-modal"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="assignment-modal-title"
                 @onclick:stopPropagation="true">

                <div class="assignment-modal-header">

                    <div>
                        <span class="assignment-status @GetStatusClass(selectedAssignment)">
                            @GetStatusText(selectedAssignment)
                        </span>

                        <h2 id="assignment-modal-title">
                            @selectedAssignment.Name
                        </h2>
                    </div>

                    <button type="button"
                            class="assignment-modal-close"
                            @onclick="CloseDetails"
                            aria-label="Close details">
                        &times;
                    </button>

                </div>

                <div class="assignment-modal-body">

                    <section class="assignment-modal-section">
                        <h3>Description</h3>

                        @if (string.IsNullOrWhiteSpace(selectedAssignment.Description))
                        {
                            <p>No description available.</p>
                        }
                        else
                        {
                            <p>@selectedAssignment.Description</p>
                        }
                    </section>

                    <div class="assignment-modal-info-grid">

                        <div class="assignment-modal-info-item">
                            <span>Deadline</span>
                            <strong>
                                @selectedAssignment.Deadline.ToString("dd MMM yyyy HH:mm")
                            </strong>
                        </div>

                        <div class="assignment-modal-info-item">
                            <span>Created</span>
                            <strong>
                                @(selectedAssignment.CreatedAt?.ToString("dd MMM yyyy")
                                    ?? "Not available")
                            </strong>
                        </div>

                        <div class="assignment-modal-info-item">
                            <span>Grade</span>
                            <strong>
                                @(selectedAssignment.Grade?.ToString("0.##")
                                    ?? "Not graded")
                            </strong>
                        </div>

                    </div>

                    <section class="assignment-modal-section">
                        <h3>Teacher feedback</h3>

                        @if (selectedAssignment.HasFeedback)
                        {
                            @if (!string.IsNullOrWhiteSpace(selectedAssignment.Comment))
                            {
                                <div class="assignment-feedback">
                                    @selectedAssignment.Comment
                                </div>
                            }
                            else
                            {
                                <p>
                                    Feedback is available, but no comment was provided.
                                </p>
                            }
                        }
                        else
                        {
                            <p>No feedback available yet.</p>
                        }
                    </section>

                </div>

                <div class="assignment-modal-footer">
                    <button type="button"
                            class="assignment-button secondary"
                            @onclick="CloseDetails">
                        Close
                    </button>
                </div>

            </div>
        </div>
    }

</div>

@code {
    private bool isLoading = true;
    private bool hasError = false;
    private AssignmentDetailsDto? selectedAssignment;
    private bool showDetailsModal;
    private List<AssignmentDetailsDto> assignments = new();

    private bool hasAssignments => assignments.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            hasError = false;

            var response = await ApiProxyClient.GetAsync<PagedResponse<AssignmentDetailsDto>>(
                                    "Activity/my-assignments?PageNumber=1&PageSize=100");

            assignments = response?.Items?.ToList() ?? [];

        }
        catch
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private string GetStatusText(AssignmentDetailsDto assignment)
    {
        return assignment.AssignmentStatus switch
        {
            AssignmentStatus.Unsubmitted => "To do",
            AssignmentStatus.Submitted => "Submitted",
            AssignmentStatus.Late => "Overdue",
            _ => "Unknown"
        };
    }

    private string GetStatusClass(AssignmentDetailsDto assignment)
    {
        return assignment.AssignmentStatus switch
        {
            AssignmentStatus.Unsubmitted => "todo",
            AssignmentStatus.Submitted => "awaiting",
            AssignmentStatus.Late => "overdue",
            _ => string.Empty
        };
    }
    private void ViewDetails(AssignmentDetailsDto assignment)
    {
        selectedAssignment = assignment;
        showDetailsModal = true;
    }

    private void CloseDetails()
    {
        showDetailsModal = false;
        selectedAssignment = null;
    }
}
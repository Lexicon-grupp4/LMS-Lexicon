@page "/assignments"
@using LMS.Blazor.Client.Components

<PageTitle>Inlämningar</PageTitle>

<div class="assignments-page">

    <PageHeader Title="Inlämningar"
                Description="Här ser du dina inlämningsuppgifter och deras status." />

    <div class="assignment-card">
        <div>
            <span class="assignment-status pending">Ej inlämnad</span>
            <h2>React application</h2>
            <p>Deadline: 2026-10-10</p>
        </div>

        <button class="assignment-button">
            Lämna in
        </button>
    </div>

    <div class="assignment-card">
        <div>
            <span class="assignment-status submitted">Inlämnad</span>
            <h2>Databasdesign</h2>
            <p>Deadline: 2026-10-15</p>
        </div>

        <button class="assignment-button secondary">
            Visa inlämning
        </button>
    </div>

    <div class="assignment-card">
        <div>
            <span class="assignment-status late">Försenad</span>
            <h2>ASP.NET Core Exercise</h2>
            <p>Deadline: 2026-10-05</p>
        </div>

        <button class="assignment-button">
            Lämna in
        </button>
    </div>

</div>
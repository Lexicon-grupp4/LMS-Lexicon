@page "/course/edit/{id:int}"
@using LMS.Blazor.Client.Components
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.DTOs.CourseDtos

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager

<PageTitle>Edit course</PageTitle>

<div class="course-page">
    @if (isLoading)
    {
        <p>Loading...</p>
    }
    else
    {
        <EditForm Model="model" OnValidSubmit="HandleValidSubmit">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Name</label>
                <InputText class="form-control" @bind-Value="model.Name" />
            </div>

            <div class="mb-3">
                <label class="form-label">Code</label>
                <InputText class="form-control" @bind-Value="model.Code" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <InputTextArea class="form-control" @bind-Value="model.Description" />
            </div>

            <div class="mb-3">
                <label class="form-label">Start date</label>
                <InputDate class="form-control" @bind-Value="model.StartDate" />
            </div>

            <div class="mb-3">
                <label class="form-label">End date</label>
                <InputDate class="form-control" @bind-Value="model.EndDate" />
            </div>

            <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                @(isSubmitting ? "Saving..." : "Save")
            </button>
        </EditForm>
    }
</div>

@code {
    [Parameter] public int id { get; set; }

    private CourseModel model = new();
    private bool isSubmitting = false;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            CourseDto? course = await ApiProxyClient.GetAsync<CourseDto>($"courses/{id}");
            if (course == null)
                return;
            model.Id = course.Id;
            model.Name = course.Name;
            model.Code = course.Code;
            model.Description = course.Description;
            model.StartDate = course.StartDate;
            model.EndDate = course.EndDate;
            isLoading = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task HandleValidSubmit()
    {
        isSubmitting = true;
        try
        {
            var dto = new PatchCourseDto(
                model.Id,
                model.Name,
                model.Code,
                model.Description,
                model.StartDate,
                model.EndDate);

            await ApiProxyClient.PatchAsync<PatchCourseDto, CourseDto>("courses", dto);
            NavigationManager.NavigateTo("/courses");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class CourseModel
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Code { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime EndDate { get; set; } = DateTime.Today.AddDays(10);
    }
}
@page "/modules/{ModuleId:int}/activities"

@using LMS.Shared.DTOs.Activity
@using LMS.Shared.Paging
@using LMS.Blazor.Client.Services.ApiProxy
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Teacher,Student")]

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JSRuntime

<PageTitle>Module Activities</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3>Module Activities / Schedule</h3>
        <p class="text-muted mb-0">
            Activities ordered by start time
        </p>
    </div>

    @if (isTeacher)
    {
        <a class="btn btn-primary"
           href="@($"/activities/create/{ModuleId}")">
            <span class="bi bi-plus-circle"></span>
            Add Activity
        </a>
    }
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if (activities.Count == 0 &&
         string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-info">
        No activities have been scheduled for this module yet.
    </div>
}
else if (activities.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Activity Type</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Start Time</th>
                    <th>End Time</th>

                    @if (isTeacher)
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var activity in activities)
                {
                    <tr @key="activity.Id">
                        <td>
                            @(activity.ActionTypeName ?? "Unknown")
                        </td>
                        <td>@activity.Title</td>
                        <td>@activity.Description</td>
                        <td>
                            @activity.StartDate.ToString("yyyy-MM-dd HH:mm")
                        </td>
                        <td>
                            @activity.EndDate.ToString("yyyy-MM-dd HH:mm")
                        </td>

                        @if (isTeacher)
                        {
                            <td>
                                <a class="btn btn-sm btn-primary mb-1"
                                   href="@($"/activities/edit/{activity.Id}")">
                                    <span class="bi bi-pencil"></span>
                                    Edit
                                </a>

                                <button type="button"
                                        class="btn btn-sm btn-danger mb-1"
                                        disabled="@isDeleting"
                                        @onclick="() => DeleteActivity(activity.Id)">
                                    <span class="bi bi-trash"></span>
                                    Delete
                                </button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a class="btn btn-secondary"
   href="@($"/courses")">
    Back to Courses
</a>

@code {
    [Parameter]
    public int ModuleId { get; set; }

    private List<ActivityDto> activities = [];
    private bool isLoading = true;
    private bool isTeacher;
    private bool isDeleting;
    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        var authState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        isTeacher = authState.User.IsInRole("Teacher");

        await LoadActivities();
    }

    private async Task LoadActivities()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var response =
                await ApiProxyClient.GetAsync<PagedResponse<ActivityDto>>(
                    $"Activity/module/{ModuleId}?PageNumber=1&PageSize=100");

            activities = response?.Items
                .OrderBy(a => a.StartDate)
                .ThenBy(a => a.Id)
                .ToList() ?? [];
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                "/Account/Login",
                forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteActivity(int id)
    {
        if (!isTeacher || isDeleting)
            return;

        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to delete this activity?");

        if (!confirmed)
            return;

        isDeleting = true;
        errorMessage = null;

        try
        {
            await ApiProxyClient.DeleteAsync($"Activity/{id}");

            activities.RemoveAll(a => a.Id == id);
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                "/Account/Login",
                forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }
}
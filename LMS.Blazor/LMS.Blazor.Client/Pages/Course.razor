@page "/course"
@using System.Net
@using LMS.Blazor.Client.Components
@using LMS.Blazor.Client.Helper
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.DTOs.CourseDtos
@using LMS.Shared.DTOs.Module
@using LMS.Shared.Paging
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Student")]

@inject IApiProxyClient ApiProxyClient

<PageTitle>Course</PageTitle>

<div class="course-page">

    <PageHeader Title="My Course"
                Description="Here you can see information about your course and the modules included." />

    @if (isLoading)
    {
        <ContentState Type="loading" />
    }
    else if (hasError)
    {
        <ContentState Type="error"
                      Message="Could not load your course." />
    }
    else if (course is null)
    {
        <ContentState Type="empty"
                      Message="You are not assigned to a course yet." />
    }
    else
    {
        <section class="course-card">
            <h2>@course.Name</h2>
            <p>@course.Description</p>

            <div class="course-dates">
                <span>Start: @course.StartDate.ToString("yyyy-MM-dd")</span>
                <span>End: @course.EndDate.ToString("yyyy-MM-dd")</span>
            </div>
        </section>

        <section class="modules-section">
            <h2>Modules</h2>

            @if (modules.Count == 0)
            {
                <ContentState Type="empty"
                              Message="There are no modules in this course yet." />
            }
            else
            {
                @foreach (var module in modules)
                {
                    <div class="module-card">
                        <div>
                            <h3>@module.Name</h3>
                            <p>@module.Description</p>
                        </div>
                        <span>@GetStatus(module)</span>
                    </div>
                }
            }
        </section>
    }
</div>

@code {
    private CourseDto? course;
    private List<ModuleDto> modules = [];
    private bool isLoading = true;
    private bool hasError = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            course = await ApiProxyClient.GetAsync<CourseDto>("courses/my-course");

            if (course is not null)
            {
                var result = await ApiProxyClient.GetAsync<PagedResponse<ModuleDto>>(
                    $"Module/course/{course.Id}");

                modules = result?.Items.OrderBy(m => m.StartDate).ToList() ?? [];
            }
        }
        catch (ApiException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            // The student has no course yet.
            course = null;
        }
        catch (Exception)
        {
            hasError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetStatus(ModuleDto module)
    {
        var today = DateTime.Today;

        if (module.EndDate < today)
            return "Completed";

        return module.StartDate <= today ? "Ongoing" : "Upcoming";
    }
}

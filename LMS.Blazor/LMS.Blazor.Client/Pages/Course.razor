@page "/course"
@using LMS.Blazor.Client.Components
@using LMS.Blazor.Client.Services.ApiProxy
@using LMS.Shared.DTOs.CourseDtos

@inject IApiProxyClient ApiProxyClient

<PageTitle>Course</PageTitle>

<div class="course-page">
    <div class="course-header">
        <h1>My Course</h1>
        <p>Here you can see information about your course and the modules included.</p>
    </div>

    <section class="course-card">
        <h2>Lexicon LTU</h2>
        <p>
            Full-stack education focused on .NET, databases, and frontend development.
        </p>

        <div class="course-dates">
            <span>Start: 2026-09-01</span>
            <span>End: 2027-05-31</span>
        </div>
    </section>

    <section class="modules-section">
        <h2>Modules</h2>

        <div class="module-card">
            <div>
                <h3>HTML & CSS</h3>
                <p>Basic web design and responsive layout.</p>
            </div>
            <span>Completed</span>
        </div>

        <div class="module-card">
            <div>
                <h3>JavaScript</h3>
                <p>JavaScript, DOM, and modern web applications.</p>
            </div>
            <span>Ongoing</span>
        </div>

        <div class="module-card">
            <div>
                <h3>.NET</h3>
                <p>C#, ASP.NET Core, and full-stack development.</p>
            </div>
            <span>Upcoming</span>
        </div>
    </section>
</div>
@page "/users/delete/{Id}"

@using LMS.Shared.DTOs.UserDtos
@using LMS.Blazor.Client.Services.ApiProxy
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Teacher")]

@inject IApiProxyClient ApiProxyClient
@inject NavigationManager NavigationManager

<PageTitle>Delete User</PageTitle>

<h3>Delete User</h3>

@if (isLoading)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">
                Loading...
            </span>
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>

    <button class="btn btn-secondary"
            @onclick="Cancel">
        Back
    </button>
}
else if (user is not null)
{
    <div class="card">

        <div class="card-body">

            <h5 class="card-title">
                Are you sure you want to delete this user?
            </h5>

            <div class="mt-3">

                <dl class="row">

                    <dt class="col-sm-3">
                        First Name
                    </dt>

                    <dd class="col-sm-9">
                        @user.FirstName
                    </dd>

                    <dt class="col-sm-3">
                        Last Name
                    </dt>

                    <dd class="col-sm-9">
                        @user.LastName
                    </dd>

                    <dt class="col-sm-3">
                        Email
                    </dt>

                    <dd class="col-sm-9">
                        @user.Email
                    </dd>

                    <dt class="col-sm-3">
                        Role
                    </dt>

                    <dd class="col-sm-9">
                        @user.Role
                    </dd>

                    <dt class="col-sm-3">
                        Course
                    </dt>

                    <dd class="col-sm-9">
                        @(string.IsNullOrWhiteSpace(user.Course)
                            ? "No course"
                            : user.Course)
                    </dd>

                </dl>

            </div>

            <div class="alert alert-warning">
                <strong>Warning:</strong>
                This action cannot be undone.
            </div>

            <button class="btn btn-danger"
                    @onclick="SumbitDeleteUser"
                    disabled="@isDeleting">

                @if (isDeleting)
                {
                    <span>
                        <span class="spinner-border spinner-border-sm me-1">
                        </span>

                        Deleting...
                    </span>
                }
                else
                {
                    <span>
                        <span class="bi bi-trash"></span>
                        Delete User
                    </span>
                }

            </button>

            <button class="btn btn-secondary ms-2"
                    @onclick="Cancel"
                    disabled="@isDeleting">

                Cancel

            </button>

        </div>

    </div>
}

@code
{
    [Parameter]
    public string Id { get; set; } = string.Empty;

    private UserDto? user;

    private bool isLoading = true;

    private bool isDeleting;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadUser();
    }

    private async Task LoadUser()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            user =
                await ApiProxyClient.GetAsync<UserDto>(
                    $"users/{Id}");

            if (user is null)
            {
                errorMessage = "User not found.";
            }
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                "/Account/Login",
                forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SumbitDeleteUser()
    {
        isDeleting = true;
        errorMessage = null;

        try
        {
            await ApiProxyClient.DeleteAsync(
                $"users/{Id}");

            NavigationManager.NavigateTo("/users");
        }
        catch (UnauthorizedAccessException)
        {
            NavigationManager.NavigateTo(
                "/Account/Login",
                forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/users");
    }
}
@implements IDisposable

@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Lexicon LMS</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door" aria-hidden="true"></span>
                Dashboard
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="course">
                <span class="bi bi-book" aria-hidden="true"></span>
                Min kurs
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="assignments">
                <span class="bi bi-file-earmark-text" aria-hidden="true"></span>
                Inlämningar
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="participants">
                <span class="bi bi-people" aria-hidden="true"></span>
                Kursdeltagare
            </NavLink>
        </div>
        <!-- Teacher only -->
        <AuthorizeView Roles="Teacher">
            <Authorized>

                <!-- User Management -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="users">
                        <span class="bi bi-person-gear" aria-hidden="true"></span>
                        User Management
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link"
                             href="courses">
                        <span class="bi bi-person-gear" aria-hidden="true"></span>
                        Course Management
                    </NavLink>
                </div>

            </Authorized>
        </AuthorizeView>
        <AuthorizeView>
            <Authorized>
                <div class="nav-user-section">
                    <div class="nav-item px-3">
                        <span class="nav-user">
                            <span class="bi bi-person-circle" aria-hidden="true"></span>
                            @context.User.Identity?.Name
                        </span>
                    </div>

                    <div class="nav-item px-3">
                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />

                            <button type="submit" class="nav-link logout-button">
                                <span class="bi bi-box-arrow-left" aria-hidden="true"></span>
                                Logout
                            </button>
                        </form>
                    </div>
                </div>
            </Authorized>

            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person" aria-hidden="true"></span>
                        Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>

    </nav>
</div>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}